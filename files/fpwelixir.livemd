new_num
```

```elixir
defmodule ReverseNums do
  def reverse_digits(original_num) do
    num_str = Integer.to_string(original_num)
    reverse_str(num_str, "")
  end

  def reverse_str(str, reversed_str \\"")
  def reverse_str("", reversed_str), do: String.to_integer(reversed_str)
  def reverse_str(str, reversed_str) do
    new_reversed = String.first(str) <> reversed_str 
    rest_of_string = String.slice(str, 1..-1//1)
    reverse_str(rest_of_string, new_reversed)
  end

end

ReverseNums.reverse_digits(94804)
```

### Reverse a number without using strings

```elixir
defmodule ReverseNum do
  def reversioso(num, acc \\0) 
  def reversioso(0, acc), do: acc
  def reversioso(num, acc) do
    new_num = div num, 10
    remainder = rem num, 10
    new_acc = acc * 10 + remainder
    #IO.puts("num: #{num}\nnew_num: #{new_num}\nremainder: #{remainder}\nnew_acc: #{new_acc}")
    reversioso(new_num, new_acc)
  end
end

ReverseNum.reversioso(94806)
```

## Lists

Lists are actually linked lists not arrays.

### Heads and Tails

```elixir
list = [1,2,3]
IO.puts(hd list)
tl list
```

```elixir
[ h | t ] = list
IO.puts("h: #{h}")
t
```

```elixir
list2 = ["a"]
[h|t] = list2
IO.puts(h)
t
```

### Enum

* Lists implement the Enumerable protocol
* helps you iterate over your lists/collections

```elixir
Enum.sum([1,2,3])
```

```elixir
defmodule Lists do
  #alias
  @spec sum(list(number())) :: integer()
  def sum(nums), do: sum_tail_rec(nums)
  
  #base case
  @spec sum_simple(list(number())) :: integer()
  def sum_simple([]), do: 0  
  #pattern matching inside the list parameter!?!
  def sum_simple([h | t]), do: sum_simple(t) + h

  @spec sum_tail_rec(list(number()), integer()) :: integer()
  def sum_tail_rec(nums, sum \\ 0)     #functin head with default values
  def sum_tail_rec([], sum), do: sum   #base case
  def sum_tail_rec([h|t], sum), do: sum_tail_rec(t, sum+h)
    
end

IO.puts(Lists.sum_simple([1,2,3]))

IO.puts(Lists.sum_tail_rec([1,2,3]))
```

### Documentation with mix

```
  # For a module
  @moduledoc ***
    
  Function Summary:
  1. sum
  ***

  # For a function
  @doc ***
  Returns sum of numbers in a list
  ***
  
  # spec with types for the input and output
  @spec sum(list(number())) :: number()
```
