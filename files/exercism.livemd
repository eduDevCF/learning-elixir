# Exercism

## Freelance Rates

https://exercism.org/tracks/elixir/exercises/freelancer-rates/

```elixir
defmodule FreelancerRates do
  def daily_rate(hourly_rate) do
    hourly_rate * 8.0
  end

  def apply_discount(before_discount, discount) do
    before_discount - before_discount*(discount/100)
  end

  def monthly_rate(hourly_rate, discount) do
    ceil(apply_discount((daily_rate(hourly_rate)*22), discount))
  end

  def days_in_budget(budget, hourly_rate, discount) do
    discounted_rate = apply_discount(hourly_rate, discount)
    num_hours = budget / discounted_rate / 8
    Float.floor(num_hours, 1)
  end
end
```

```elixir
FreelancerRates.daily_rate(60)
```

```elixir
FreelancerRates.apply_discount(150, 10)
```

```elixir
FreelancerRates.monthly_rate(77, 10.5)
```

```elixir
FreelancerRates.days_in_budget(20000, 80, 11.0)
```

Rewriting this module to experiment with Elixir's [pipe operator](https://elixirschool.com/en/lessons/basics/pipe_operator)

```elixir
defmodule PipedRates do
  def daily_rate(hourly_rate) do
    hourly_rate * 8.0
  end

  def apply_discount(before_discount, discount) do
    before_discount * (1 - discount/100)
  end

  def monthly_rate(hourly_rate, discount) do
    daily_rate(hourly_rate) * 22
    |> apply_discount(discount)
    |> ceil
  end

  def days_in_budget(budget, hourly_rate, discount) do
    discounted_rate = apply_discount(hourly_rate, discount)
    budget / discounted_rate / 8
    |> Float.floor(1)
  end
end
```

```elixir
PipedRates.monthly_rate(77, 10.5)
```

```elixir
PipedRates.days_in_budget(20000, 80, 11.0)
```

```elixir
PipedRates.apply_discount(150, 10)
```

## Language List

https://exercism.org/tracks/elixir/exercises/language-list/

```elixir
defmodule LanguageList do
  def new(), do: []
  def add(list, language), do: [language | list]
  def remove(list), do: tl(list) 
  def first(list), do: hd(list)
  def count([]), do: 0
  def count(list), do: count(tl(list)) + 1
  def functional_list?(list), do: "Elixir" in list
end
```

```elixir
# Forgot to set a base case for the recursive count function.
# What is the tail of a 1 item list?
[h | t] = [1, 2]
tl(t) # -> []

l = ["Elixir", "Python", "JavaScript", "PHP"]
LanguageList.count(l) # -> 4
```

```elixir
# Testing examples provided in the exercise
language_list = LanguageList.new()
IO.inspect(language_list) # => []
language_list = LanguageList.add(language_list, "Clojure")
IO.inspect(language_list) # => ["Clojure"]
language_list = LanguageList.add(language_list, "Haskell")
IO.inspect(language_list) # => ["Haskell", "Clojure"]
language_list = LanguageList.remove(language_list)
IO.inspect(language_list) # => ["Clojure"]
language_list = LanguageList.add(language_list, "Elm")
IO.inspect(language_list) # => ["Elm", "Clojure"]
language_list = LanguageList.add(language_list, "Prolog")
IO.inspect(language_list)  # => ["Prolog", "Elm", "Clojure"]
first_language = LanguageList.first(language_list)
IO.puts(first_language) # => "Prolog"
lang_count = LanguageList.count(language_list)
IO.puts(lang_count) # => 3
language_list = LanguageList.add(language_list, "Elixir")
IO.inspect(language_list) # => ["Elixir"]
functional? = LanguageList.functional_list?(language_list)
IO.puts(functional?) # => true
```

```elixir
# Here's another version I liked from Alexander-Taran's solution:
# Pattern matching for the head and tail of a list

defmodule ATLanguageList do
  def remove([_|result]), do: result
  def first([h|tail]), do: h
  def count([]), do: 0
  def count([_ | t]), do: 1 + count(t) 
end
```

## Log Level

```elixir
defmodule LogLevel do
  def to_label(level, legacy?) do
    cond do
      legacy? == true -> 
        cond do
          level == 0 -> :unknown
          level == 1 -> :debug
          level == 2 -> :info
          level == 3 -> :warning
          level == 4 -> :error
          level == 5 -> :unknown
          true -> :unknown
        end
      legacy? == false ->
        cond do
          level == 0 -> :trace
          level == 1 -> :debug
          level == 2 -> :info
          level == 3 -> :warning
          level == 4 -> :error
          level == 5 -> :fatal
          true -> :unknown
        end
      true -> "legacy? must be a boolean"
    end
  end

  def alert_recipient(level, legacy?) do
    label = to_label(level, legacy?)
    cond do
      label == :error -> :ops
      label == :fatal -> :ops
      label == :unknown ->
        cond do
          legacy? == false -> :dev2
          true -> :dev1
        end
      true -> false
    end
  end
end
```

```elixir
IO.inspect(LogLevel.to_label(0, false))
# => :trace
IO.inspect(LogLevel.to_label(0, true))
# => :unknown
IO.inspect(LogLevel.to_label(4, 3))
```

```elixir
IO.inspect(LogLevel.alert_recipient(-1, true))
# => :dev1
IO.inspect(LogLevel.alert_recipient(0, false))
# => false
```

```elixir
# 2nd interation inspired by community solutions

defmodule LogLevel2 do
  def to_label(level, legacy?) do
    cond do
      level == 0 and legacy? == false -> :trace
      level == 1 -> :debug
      level == 2 -> :info
      level == 3 -> :warning
      level == 4 -> :error
      level == 5 and legacy? == false -> :fatal
      true -> :unknown
    end
  end

  def alert_recipient(level, legacy?) do
    label = to_label(level, legacy?)
    cond do
      label == :error or label == :fatal -> :ops
      label == :unknown and legacy? -> :dev1
      label == :unknown and not legacy? -> :dev2
      true -> false
    end
  end
end
```

```elixir
IO.inspect(LogLevel2.to_label(0, false))
# => :trace
IO.inspect(LogLevel2.to_label(0, true))
# => :unknown
IO.inspect(LogLevel2.to_label(4, 3))
# the 2nd iteration does not check for cases where legacy? is not a bool :( 
```

```elixir
IO.inspect(LogLevel2.alert_recipient(-1, true))
# => :dev1
IO.inspect(LogLevel2.alert_recipient(0, false))
# => false
```

```elixir
LogLevel2.alert_recipient(6, false)
```
